# Copy to .env and fill in. nl2sql loads .env from the current directory and
# never overrides variables that are already set in your shell.

# Where to run queries. Default: the offline sample created by `nl2sql init-sample`.
NL2SQL_DB=sqlite:nl2sql_sample.db
# Azure SQL / SQL Server, connected as the READ-ONLY principal (see sql/mssql/):
# NL2SQL_DB=mssql:Server=tcp:<server>.database.windows.net,1433;Database=nl2sql_sample;UID=nl2sql_reader;PWD=<password>;Encrypt=yes;TrustServerCertificate=no
# Or with Microsoft Entra ID (no password):
# NL2SQL_DB=mssql:Server=tcp:<server>.database.windows.net,1433;Database=nl2sql_sample;Authentication=ActiveDirectoryDefault;Encrypt=yes

# SQL Server driver: auto (mssql-python if installed, else pyodbc), mssql-python or pyodbc.
NL2SQL_MSSQL_DRIVER=auto

# Generator: "stub" (offline templates, not an AI, free) or "azure-openai".
NL2SQL_PROVIDER=stub

# Semantic layer (descriptions + policy). Default: ./semantic.yaml if present.
# "sample" means the bundled one for the sample database.
# NL2SQL_SEMANTIC=semantic.yaml

# Azure OpenAI. Needed only for NL2SQL_PROVIDER=azure-openai.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Or an Entra ID bearer token instead of a key:
# AZURE_OPENAI_AD_TOKEN=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Integration tests only (see CONTRIBUTING.md):
# NL2SQL_TEST_CONN=Server=localhost,1433;Database=nl2sql_sample;UID=nl2sql_reader;PWD=...;Encrypt=yes;TrustServerCertificate=yes
# NL2SQL_TEST_WEST_CONN=...UID=nl2sql_reader_west...
# NL2SQL_TEST_ADMIN_CONN=...UID=sa...
